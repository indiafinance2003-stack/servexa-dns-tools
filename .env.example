NODE_ENV=development
APP_VERSION=0.1.0
# Production defaults to https://ravelyth.in. Set to your local origin for development.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (required for accounts, sessions, and saved analyses)
# Public DNS/email tools work without it; account features return a clear
# "temporarily unavailable" error until PostgreSQL is configured.
# NEVER commit real credentials. Server-side only — never exposed to the browser.
# Example (local development):
# DATABASE_URL=postgresql://ravelyth:ravelyth@localhost:5432/ravelyth
DATABASE_URL=

# Trust X-Forwarded-For / X-Real-IP for rate-limit keys. Enable ONLY when the
# app runs behind a reverse proxy that sets these headers (nginx in production).
# When false, requests share a single rate-limit bucket instead of trusting a
# client-controlled header. Defaults to true when NODE_ENV=production.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# No session secret is required: session tokens are opaque 256-bit random
# values; only a SHA-256 hash is stored server-side. If a future feature needs
# a secret, generate one with: openssl rand -base64 32

# DNS
DNS_TIMEOUT_MS=10000
DNS_QUERY_TIMEOUT_MS=8000
MAX_DNS_QUERIES_PER_REQUEST=32
MAX_SPF_INCLUDE_LOOKUPS=10

# Request limits
MAX_REQUEST_BODY_BYTES=1048576
MAX_EMAIL_HEADER_BYTES=262144
MAX_INDIVIDUAL_HEADER_BYTES=16000
MAX_HEADER_COUNT=150
MAX_LINE_LENGTH=998

# Rate limiting (in-memory; replace with Redis for multi-instance production)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
