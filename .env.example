NODE_ENV=development
APP_VERSION=0.1.0
# Production defaults to https://ravelyth.in. Set to your local origin for development.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (required for accounts, sessions, and saved analyses)
# Public DNS/email tools work without it; account features return a clear
# "temporarily unavailable" error until PostgreSQL is configured.
# NEVER commit real credentials. Server-side only — never exposed to the browser.
# Example (local development):
# DATABASE_URL=postgresql://ravelyth:ravelyth@localhost:5432/ravelyth
DATABASE_URL=

# Trust X-Forwarded-For / X-Real-IP for rate-limit keys. Enable ONLY when the
# app runs behind a reverse proxy that sets these headers (nginx in production).
# When false, requests share a single rate-limit bucket instead of trusting a
# client-controlled header. Defaults to true when NODE_ENV=production.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# No session secret is required: session tokens are opaque 256-bit random
# values; only a SHA-256 hash is stored server-side. If a future feature needs
# a secret, generate one with: openssl rand -base64 32

# DNS
DNS_TIMEOUT_MS=10000
DNS_QUERY_TIMEOUT_MS=8000
MAX_DNS_QUERIES_PER_REQUEST=32
MAX_SPF_INCLUDE_LOOKUPS=10

# ---------------------------------------------------------------------------
# Outbound web/TLS diagnostics (SSL checker, HTTP header checkers, website
# availability, RDAP domain information).
# HTTP_REQUEST_TIMEOUT_MS is a TOTAL budget per request including redirects.
# Ports other than 80/443 are refused, and every resolved address must be
# public unicast before a connection is attempted (SSRF protection).
HTTP_REQUEST_TIMEOUT_MS=10000
HTTP_MAX_RESPONSE_BYTES=65536
HTTP_MAX_REDIRECTS=3
HTTP_MAX_ADDRESS_ATTEMPTS=3
# ---------------------------------------------------------------------------
# Part 2 — Public support/request surfaces (PART 3 may add a private operator
# tier later). Until then, the public-facing routes are the only ones
# configured to render in the help center.
ENABLE_PUBLIC_HELP_CENTER_TIER=1
PARTNER_ACTIVE_TIER=0
PARTNER_PRIVATE_ONLY=0

# In Part 2, "public" partner/help contacts are exposed only when there is at
# least one configured, publicly visible account tier. If this is disabled,
# partner/public-facing helpers are hidden even when rows exist.
PUBLIC_FACING_HELPER_TIER_ENABLED=1

TLS_CONNECT_TIMEOUT_MS=10000
RDAP_TIMEOUT_MS=10000

# DNS propagation / resolver comparison: maximum number of public resolvers
# queried per request (each counts against MAX_DNS_QUERIES_PER_REQUEST).
MAX_PROPAGATION_RESOLVERS=6

# Optional public contact address shown on /contact when configured.
# Leave empty to show the documented channels only (no placeholder address).
CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Pricing pages (Part 1). In development and part-1, billing is never a live
# integration; USE_DEMO_BILLING is set automatically based on NODE_ENV.
# Setting this explicitly to "false" in a test/staging environment opts in to
# the live-flow stubs.
# USE_DEMO_BILLING=true

# Request limits
MAX_REQUEST_BODY_BYTES=1048576
MAX_EMAIL_HEADER_BYTES=262144
MAX_INDIVIDUAL_HEADER_BYTES=16000
MAX_HEADER_COUNT=150
MAX_LINE_LENGTH=998

# Rate limiting (in-memory; replace with Redis for multi-instance production)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
